# ---------------------------------------------------------------------------
# Peblo TV Mini — every variable the stack reads.
#
#   cp .env.example .env
#
# The API reads <repo>/.env (this file's copy) and then <repo>/backend/.env, by
# absolute path — wherever the process is started from. Relative paths in the values
# below resolve against the repo root, not the working directory.
# Production secret management is described in the README (Part D).
# ---------------------------------------------------------------------------

# --- runtime ----------------------------------------------------------------
ENVIRONMENT=local                 # local | ci | staging | production
LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
# The app connects with asyncpg; Alembic derives the psycopg URL from this.
DATABASE_URL=postgresql+asyncpg://peblo:peblo@localhost:5432/peblo_tv
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- auth -------------------------------------------------------------------
# "<token>:<role>" pairs, comma separated. Roles: admin (CRUD + publish), editor (CRUD).
# Dev-only convenience: `make seed` turns these into rows in the users table, which
# is what the API actually authenticates against at runtime.
API_TOKENS=dev-admin-token:admin,dev-editor-token:editor

# --- storage ----------------------------------------------------------------
STORAGE_BACKEND=local             # local | s3   (s3 covers Cloudflare R2 and MinIO)
STORAGE_LOCAL_ROOT=./storage/local     # relative to the repo root
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media

# Only read when STORAGE_BACKEND=s3. For Cloudflare R2:
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_BASE_URL=https://media.example.com   (your R2 custom domain)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- content vocabulary -----------------------------------------------------
# Leave blank to use the checked-in data/challenge/reference.json.
REFERENCE_PATH=

# --- catalogue --------------------------------------------------------------
# The pointer readers follow, and the prefix immutable per-run catalogues are written under.
CATALOG_POINTER_KEY=catalog/current.json
CATALOG_RUN_KEY_PREFIX=catalog/runs

# --- http -------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174

# --- frontends (Vite, read at build time; added in step 3) ------------------
VITE_API_BASE_URL=http://localhost:8000
