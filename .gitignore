# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Env & secrets
.env
.env.*
!.env.example

# Local object storage (published catalogues + uploaded artwork).
# Ignore the contents, not the directory, so .gitkeep survives a fresh clone.
storage/local/*
!storage/local/.gitkeep
backend/storage/

.claude/
.docs/

# Show photographs are fetched by `make artwork` and committed on purpose: seeding must
# never need the network, or `docker compose up` breaks whenever the network does.
!data/artwork/

# OS
.DS_Store
